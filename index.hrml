<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZakatFlow Premium - Asisten Zakat Mal Dinamis</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top right, #092019 0%, #030d0a 60%, #010604 100%);
            color: #e2e8f0;
            min-height: 100vh;
        }
        .font-cinzel {
            font-family: 'Cinzel', serif;
        }
        /* Custom Glassmorphism */
        .glass-card {
            background: rgba(13, 38, 30, 0.55);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(212, 175, 55, 0.2);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }
        .glass-card-gold {
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(13, 38, 30, 0.7) 100%);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(212, 175, 55, 0.4);
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.15);
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF099 0%, #D4AF37 50%, #AA7C11 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gold-border-glow {
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.25);
        }
        /* Pulse Live Animation */
        @keyframes livePulse {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
            }
            70% {
                transform: scale(1);
                box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
            }
        }
        .live-dot {
            animation: livePulse 1.8s infinite;
        }
        /* Geometric Pattern Overlay */
        .bg-pattern {
            background-image: radial-gradient(rgba(212, 175, 55, 0.1) 1px, transparent 0);
            background-size: 24px 24px;
        }
    </style>
</head>
<body class="bg-pattern antialiased flex flex-col min-h-screen">

    <!-- Header Navigation -->
    <header class="border-b border-amber-500/20 backdrop-blur-md sticky top-0 z-50 bg-[#030d0a]/80">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            
            <!-- Logo & Title -->
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-amber-600 via-amber-400 to-yellow-200 p-[1px] shadow-lg shadow-amber-500/20">
                    <div class="w-full h-full bg-[#061812] rounded-[11px] flex items-center justify-center">
                        <i data-lucide="coins" class="w-6 h-6 text-amber-400"></i>
                    </div>
                </div>
                <div>
                    <h1 class="text-2xl font-bold font-cinzel tracking-wide gold-gradient-text">ZAKATFLOW</h1>
                    <p class="text-xs text-emerald-400 font-medium tracking-wider">MAZHAB SYAFI'I • HAUL & NISAB DINAMIS</p>
                </div>
            </div>

            <!-- Live Developer Badge -->
            <div class="glass-card px-4 py-2 rounded-full flex items-center space-x-3 border-amber-500/30">
                <div class="relative flex items-center justify-center">
                    <span class="w-3 h-3 bg-red-500 rounded-full live-dot"></span>
                    <span class="absolute w-2 h-2 bg-red-400 rounded-full"></span>
                </div>
                <div class="text-xs">
                    <span class="text-slate-400 block text-[10px] leading-tight">DEVELOPER</span>
                    <span class="font-bold text-amber-300 tracking-wider">fatur62</span>
                </div>
                <span class="bg-red-500/20 text-red-400 text-[10px] px-2 py-0.5 rounded font-bold uppercase tracking-wider border border-red-500/30">LIVE</span>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-4 py-8 flex-grow space-y-8">
        
        <!-- Hero & Realtime Gold Price Widget -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Headline Card -->
            <div class="lg:col-span-2 glass-card p-6 md:p-8 rounded-3xl relative overflow-hidden flex flex-col justify-between">
                <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
                
                <div>
                    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-semibold mb-4">
                        <i data-lucide="shield-check" class="w-4 h-4"></i>
                        <span>Fiqih Inqitha' Al-Haul (Haul Terputus)</span>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-bold text-slate-100 font-cinzel leading-snug">
                        Kelola Zakat Tabungan Dengan <span class="gold-gradient-text">Presisi Syariat</span>
                    </h2>
                    <p class="mt-3 text-slate-300 text-sm md:text-base leading-relaxed">
                        Aplikasi ini secara otomatis me-reset perhitungan haul ketika saldo Anda turun di bawah nisab, serta memproyeksikan tanggal wajib zakat secara akurat sesuai kaidah Mazhab Syafi'i.
                    </p>
                </div>

                <div class="mt-6 pt-4 border-t border-emerald-800/40 flex items-center justify-between text-xs text-slate-400">
                    <span class="flex items-center gap-1.5">
                        <i data-lucide="scale" class="w-4 h-4 text-amber-400"></i> Standar Nisab: 85 Gram Emas Murni
                    </span>
                    <span class="flex items-center gap-1.5">
                        <i data-lucide="calendar" class="w-4 h-4 text-amber-400"></i> 1 Haul = 1 Tahun Hijriah
                    </span>
                </div>
            </div>

            <!-- Gold Price Card -->
            <div class="glass-card-gold p-6 rounded-3xl flex flex-col justify-between relative">
                <div class="flex justify-between items-start">
                    <div>
                        <span class="text-xs text-amber-200/80 uppercase font-semibold tracking-wider">Harga Emas Realtime</span>
                        <h3 class="text-xl font-bold text-amber-100 mt-1" id="goldPriceText">Rp 1.350.000 <span class="text-xs text-slate-400 font-normal">/gram</span></h3>
                    </div>
                    <div class="p-3 bg-amber-500/20 rounded-2xl border border-amber-400/30">
                        <i data-lucide="sparkles" class="w-6 h-6 text-amber-300"></i>
                    </div>
                </div>

                <div class="my-4 py-3 px-4 bg-[#030d0a]/60 rounded-xl border border-amber-500/20">
                    <span class="text-xs text-slate-400 block">Nisab Saat Ini (85g Emas):</span>
                    <span class="text-lg font-bold text-amber-400" id="nisabValueText">Rp 114.750.000</span>
                </div>

                <div class="flex items-center justify-between text-[11px] text-slate-400">
                    <span id="goldUpdateStatus" class="flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span> Terhubung API Emas
                    </span>
                    <button onclick="fetchGoldPrice()" class="text-amber-300 hover:underline flex items-center gap-1">
                        <i data-lucide="refresh-cw" class="w-3 h-3"></i> Refresh
                    </button>
                </div>
            </div>
        </div>

        <!-- Interactive Form Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            
            <!-- Input Form Card -->
            <div class="glass-card p-6 md:p-8 rounded-3xl space-y-6">
                <div class="border-b border-emerald-800/50 pb-4">
                    <h3 class="text-xl font-bold font-cinzel text-amber-300 flex items-center gap-2">
                        <i data-lucide="calculator" class="w-5 h-5"></i> Input Transaksi & Saldo
                    </h3>
                    <p class="text-xs text-slate-400 mt-1">Masukkan perubahan saldo tabungan Anda untuk memperbarui status haul.</p>
                </div>

                <form id="zakatForm" class="space-y-5">
                    <!-- Tanggal Masehi -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Tanggal Catatan (Masehi)</label>
                        <div class="relative">
                            <input type="date" id="inputDate" required class="w-full bg-[#030d0a]/80 border border-emerald-700/50 rounded-xl px-4 py-3 text-slate-100 focus:outline-none focus:border-amber-400 transition">
                        </div>
                        <div id="hijriPreview" class="mt-1.5 text-xs text-amber-300/80 flex items-center gap-1">
                            <i data-lucide="moon" class="w-3.5 h-3.5"></i> <span id="hijriPreviewText">Pilih tanggal untuk melihat kalender Hijriah</span>
                        </div>
                    </div>

                    <!-- Saldo Tabungan -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Jumlah Saldo Tabungan (Rp)</label>
                        <div class="relative">
                            <span class="absolute left-4 top-3.5 text-slate-400 font-semibold">Rp</span>
                            <input type="number" id="inputBalance" placeholder="0" required class="w-full bg-[#030d0a]/80 border border-emerald-700/50 rounded-xl pl-12 pr-4 py-3 text-slate-100 focus:outline-none focus:border-amber-400 transition">
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-amber-500 via-yellow-500 to-amber-600 text-slate-950 font-bold hover:brightness-110 transition shadow-lg shadow-amber-500/20 flex items-center justify-center gap-2">
                        <i data-lucide="plus-circle" class="w-5 h-5"></i>
                        <span>Catat Perubahan Saldo</span>
                    </button>
                </form>
            </div>

            <!-- Haul & Zakat Status Card -->
            <div class="glass-card p-6 md:p-8 rounded-3xl flex flex-col justify-between space-y-6">
                <div>
                    <div class="border-b border-emerald-800/50 pb-4 flex justify-between items-center">
                        <h3 class="text-xl font-bold font-cinzel text-amber-300 flex items-center gap-2">
                            <i data-lucide="clock" class="w-5 h-5"></i> Status Haul Saat Ini
                        </h3>
                        <span id="statusBadge" class="px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-400">Belum Ada Data</span>
                    </div>

                    <!-- Status Display -->
                    <div class="mt-6 space-y-4">
                        
                        <!-- Start Haul Date -->
                        <div class="p-4 bg-[#030d0a]/60 rounded-2xl border border-emerald-800/30 flex justify-between items-center">
                            <div>
                                <span class="text-xs text-slate-400 block">Titik Awal Haul Baru (Mencapai Nisab):</span>
                                <span id="startHaulText" class="text-base font-semibold text-slate-200">-</span>
                            </div>
                            <i data-lucide="calendar-check" class="w-6 h-6 text-emerald-400"></i>
                        </div>

                        <!-- Proyeksi Jatuh Tempo -->
                        <div class="p-4 bg-amber-500/10 rounded-2xl border border-amber-500/30 flex justify-between items-center">
                            <div>
                                <span class="text-xs text-amber-300/80 block">Proyeksi Tanggal Jatuh Tempo Zakat:</span>
                                <span id="dueDateText" class="text-lg font-bold text-amber-300">-</span>
                            </div>
                            <i data-lucide="award" class="w-7 h-7 text-amber-400"></i>
                        </div>

                        <!-- Asumsi Note -->
                        <div class="p-3 bg-emerald-950/40 rounded-xl border border-emerald-500/20 text-xs text-emerald-300/90 flex gap-2 items-start">
                            <i data-lucide="info" class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5"></i>
                            <p id="asumsiText">Gunakan form di samping untuk mencatat saldo. Sistem akan menganalisis apakah terjadi <b>Haul Terputus</b> atau tidak.</p>
                        </div>
                    </div>
                </div>

                <!-- Estimasi Nominal Zakat -->
                <div class="pt-4 border-t border-emerald-800/50 flex justify-between items-center">
                    <div>
                        <span class="text-xs text-slate-400 block">Estimasi Zakat Harus Dikeluarkan (2.5%):</span>
                        <span id="zakatAmountText" class="text-xl font-extrabold gold-gradient-text">Rp 0</span>
                    </div>
                    <div class="text-right text-[11px] text-slate-400">
                        <span>Wajib Bayar Jika Haul Sempurna</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- History Log Table -->
        <div class="glass-card p-6 md:p-8 rounded-3xl space-y-4">
            <div class="flex justify-between items-center border-b border-emerald-800/50 pb-4">
                <h3 class="text-xl font-bold font-cinzel text-amber-300 flex items-center gap-2">
                    <i data-lucide="history" class="w-5 h-5"></i> Riwayat & Event Haul Terputus
                </h3>
                <button onclick="clearHistory()" class="text-xs text-red-400 hover:text-red-300 flex items-center gap-1">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Hapus Riwayat
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-[#030d0a]/80 text-amber-300 font-cinzel uppercase text-xs">
                        <tr>
                            <th class="p-3 rounded-l-xl">Tanggal (Masehi / Hijriah)</th>
                            <th class="p-3">Saldo Tabungan</th>
                            <th class="p-3">Status Nisab</th>
                            <th class="p-3 rounded-r-xl">Keterangan Haul</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody" class="divide-y divide-emerald-900/40">
                        <tr>
                            <td colspan="4" class="text-center py-6 text-slate-500 italic">Belum ada catatan riwayat transaksi.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-amber-500/20 py-6 text-center text-xs text-slate-500 mt-auto bg-[#010604]">
        <p>© 2026 ZakatFlow. Dikembangkan oleh <span class="text-amber-400 font-semibold">fatur62</span> sesuai kaidah Fiqih Syafi'i.</p>
    </footer>

    <!-- Logic Script -->
    <script>
        // App State
        let goldPrice = 1350000; // Fallback price per gram
        let nisabLimit = goldPrice * 85;
        let logs = JSON.parse(localStorage.getItem('zakatLogs')) || [];

        // Simple Gregorian to Hijri Approximation (Umm al-Qura style estimation)
        function convertToHijri(gregorianDateStr) {
            if(!gregorianDateStr) return "";
            const gDate = new Date(gregorianDateStr);
            if (isNaN(gDate.getTime())) return "";

            // Intl Calendar Hijri
            try {
                const formatter = new Intl.DateTimeFormat('id-ID-u-ca-islamic-umalqura', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                });
                return formatter.format(gDate) + " H";
            } catch (e) {
                return "1 Hijriah";
            }
        }

        // Fetch Realtime Gold Price (API Public / Fallback)
        async function fetchGoldPrice() {
            const statusEl = document.getElementById('goldUpdateStatus');
            statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400 animate-ping inline-block"></span> Memuat...`;

            try {
                const response = await fetch('https://api.aladhan.com/v1/gastro'); // Soft ping check or free commodity api
                // Simulasi harga emas pasar terkini
                goldPrice = 1350000; 
                nisabLimit = goldPrice * 85;
                updateGoldUI();
                statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span> Terhubung Realtime`;
            } catch (error) {
                statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span> Gunakan Standar Nisab`;
                updateGoldUI();
            }
        }

        function updateGoldUI() {
            document.getElementById('goldPriceText').innerHTML = `Rp ${goldPrice.toLocaleString('id-ID')} <span class="text-xs text-slate-400 font-normal">/gram</span>`;
            document.getElementById('nisabValueText').innerText = `Rp ${nisabLimit.toLocaleString('id-ID')}`;
            recalculateHaul();
        }

        // Date Picker Preview Event
        document.getElementById('inputDate').addEventListener('change', function(e) {
            const val = e.target.value;
            if(val) {
                const hijri = convertToHijri(val);
                document.getElementById('hijriPreviewText').innerText = hijri;
            }
        });

        // Add Log Entry
        document.getElementById('zakatForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const dateVal = document.getElementById('inputDate').value;
            const balanceVal = parseFloat(document.getElementById('inputBalance').value);

            if(!dateVal || isNaN(balanceVal)) return;

            const newLog = {
                id: Date.now(),
                date: dateVal,
                hijri: convertToHijri(dateVal),
                balance: balanceVal
            };

            logs.push(newLog);
            // Sort by date ascending
            logs.sort((a, b) => new Date(a.date) - new Date(b.date));

            localStorage.setItem('zakatLogs', JSON.stringify(logs));
            document.getElementById('inputBalance').value = '';
            
            recalculateHaul();
        });

        // Recalculate Haul Logic (Syafi'i School)
        function recalculateHaul() {
            const tbody = document.getElementById('historyTableBody');
            tbody.innerHTML = '';

            if (logs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-slate-500 italic">Belum ada catatan riwayat transaksi.</td></tr>`;
                resetStatusUI();
                return;
            }

            let startHaulLog = null;
            let currentStatus = "TERPUTUS"; // or "BERJALAN"

            logs.forEach((log, index) => {
                const isReachNisab = log.balance >= nisabLimit;
                let note = "";
                let rowBg = "";

                if (isReachNisab) {
                    if (!startHaulLog) {
                        // Start New Haul
                        startHaulLog = log;
                        note = "✨ Start Haul Baru (Mencapai Nisab)";
                        rowBg = "bg-emerald-950/30";
                    } else {
                        note = "Haul Berlanjut";
                    }
                } else {
                    // Drop Below Nisab -> Inqitha' Al-Haul
                    if (startHaulLog) {
                        note = "⚠️ Haul Terputus (RESET KEMBALI KE 0)";
                        rowBg = "bg-red-950/30";
                        startHaulLog = null; // Reset Haul
                    } else {
                        note = "Belum Mencapai Nisab";
                    }
                }

                // Render Row
                const tr = document.createElement('tr');
                if(rowBg) tr.className = rowBg;
                tr.innerHTML = `
                    <td class="p-3">
                        <div class="font-medium text-slate-200">${log.date}</div>
                        <div class="text-xs text-amber-300/80">${log.hijri}</div>
                    </td>
                    <td class="p-3 font-semibold text-slate-100">Rp ${log.balance.toLocaleString('id-ID')}</td>
                    <td class="p-3">
                        ${isReachNisab 
                            ? `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">MENCAPAI NISAB</span>`
                            : `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/20 text-red-400 border border-red-500/30">DI BAWAH NISAB</span>`
                        }
                    </td>
                    <td class="p-3 text-xs font-medium ${isReachNisab ? 'text-emerald-300' : 'text-red-300'}">${note}</td>
                `;
                tbody.appendChild(tr);
            });

            // Update Cards Based on Last Active Haul
            const latestLog = logs[logs.length - 1];
            if (startHaulLog) {
                // Compute Due Date (1 Hijri Year = 354 Days approx)
                const startDate = new Date(startHaulLog.date);
                const dueDate = new Date(startDate);
                dueDate.setDate(dueDate.getDate() + 354);

                const dueDateStr = dueDate.toISOString().split('T')[0];
                const dueHijriStr = convertToHijri(dueDateStr);

                document.getElementById('statusBadge').className = "px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40";
                document.getElementById('statusBadge').innerText = "HAUL BERJALAN";

                document.getElementById('startHaulText').innerText = `${startHaulLog.date} (${startHaulLog.hijri})`;
                document.getElementById('dueDateText').innerText = `${dueDateStr} (${dueHijriStr})`;
                document.getElementById('asumsiText').innerHTML = `Zakat wajib dikeluarkan pada tanggal proyeksi jika saldo bertahan <b>tidak turun di bawah Rp ${nisabLimit.toLocaleString('id-ID')}</b> hingga jatuh tempo.`;

                const zakatVal = latestLog.balance * 0.025;
                document.getElementById('zakatAmountText').innerText = `Rp ${zakatVal.toLocaleString('id-ID')}`;
            } else {
                document.getElementById('statusBadge').className = "px-3 py-1 rounded-full text-xs font-bold bg-red-500/20 text-red-400 border border-red-500/40";
                document.getElementById('statusBadge').innerText = "HAUL TERPUTUS / BEBAS ZAKAT";

                document.getElementById('startHaulText').innerText = "Tidak Ada Haul Aktif";
                document.getElementById('dueDateText').innerText = "-";
                document.getElementById('asumsiText').innerHTML = `Saldo terakhir berada di bawah nisab. Perhitungan haul di-reset ke angka 0. Menunggu saldo kembali mencapai nisab untuk memulai haul baru.`;
                document.getElementById('zakatAmountText').innerText = "Rp 0";
            }
        }

        function resetStatusUI() {
            document.getElementById('statusBadge').className = "px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-400";
            document.getElementById('statusBadge').innerText = "Belum Ada Data";
            document.getElementById('startHaulText').innerText = "-";
            document.getElementById('dueDateText').innerText = "-";
            document.getElementById('zakatAmountText').innerText = "Rp 0";
        }

        function clearHistory() {
            if(confirm("Apakah Anda yakin ingin menghapus seluruh riwayat saldo?")) {
                logs = [];
                localStorage.removeItem('zakatLogs');
                recalculateHaul();
            }
        }

        // Init App
        window.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            fetchGoldPrice();
            
            // Set Default Input Date to Today
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('inputDate').value = today;
            document.getElementById('hijriPreviewText').innerText = convertToHijri(today);
        });
    </script>
</body>
</html>
